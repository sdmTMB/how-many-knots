	author = {Miller, David L. and Glennie, Richard and Seaton, Andrew E.},
	month = mar,
	year = {2020},
	pages = {1--16},
	file = {Springer Full Text PDF:/Users/eric.ward/Zotero/storage/V5N7BK5P/Miller et al. - 2020 - Understanding the Stochastic Partial Differential .pdf:application/pdf},
}

@article{yue2014,
	title = {Bayesian adaptive smoothing splines using stochastic differential equations},
	volume = {9},
